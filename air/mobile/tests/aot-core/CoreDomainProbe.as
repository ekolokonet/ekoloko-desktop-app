package {import flash.display.*;import flash.events.*;import flash.net.*;import flash.system.*;import flash.desktop.NativeApplication;import flash.filesystem.*;import flash.utils.*;import org.ekoloko.air.NativeServices;
public class CoreDomainProbe extends Sprite {private var names:Array,loaders:Array=[],phase:int=0,baseline:Object={};public function CoreDomainProbe(){NativeServices;loaderInfo.uncaughtErrorEvents.addEventListener(UncaughtErrorEvent.UNCAUGHT_ERROR,fail);var s:FileStream=new FileStream();s.open(File.applicationDirectory.resolvePath("classes.json"),FileMode.READ);names=JSON.parse(s.readUTFBytes(s.bytesAvailable)) as Array;s.close();setTimeout(function():void{trace("CORE_FAIL timeout");NativeApplication.nativeApplication.exit(3);},45000);next();}
