{
  "name": "ekoloko-rewritten",
  "version": "2.0.0",
  "author": "Arnon001 <arnon@arnon001.com>",
  "description": "Application for ekoloko",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekolokonet/ekoloko-desktop-app.git"
  },
  "scripts": {
    "start": "electron .",
    "start:beta": "electron . --beta",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac zip --x64 --arm64 --publish never -c.mac.identity=null",
    "dist:mac:dmg": "npm run dist:mac && node scripts/createMacDmg.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.ekoloko",
    "productName": "ekoloko",
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ekolokonet",
        "repo": "ekoloko-desktop-app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "executableName": "ekoloko",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": "${env.APPLE_IDENTITY}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "electronLanguages": [
      "en-US",
      "he"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "main": "src/main/index.js"
}
